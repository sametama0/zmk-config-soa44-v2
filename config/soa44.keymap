#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define JP_DQUOTE       AT                // "
#define JP_AMPERSAND    CARET             // &
#define JP_QUOTE        AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define JP_CARET        EQUAL             // ^
#define JP_YEN          0x89              // ¥
#define JP_PLUS         COLON             // +
#define JP_TILDE        PLUS              // ~
#define JP_PIPE         LS(0x89)          // |
#define JP_AT           LEFT_BRACKET      // @
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BACKQUOTE    LEFT_BRACE        // `
#define JP_UNDERSCORE   LS(0x87)          // _
#define JP_LBRACKET     RIGHT_BRACKET     // [
#define JP_RBRACKET     BACKSLASH         // ]
#define JP_LPAREN       ASTERISK          // (
#define JP_RPAREN       LEFT_PARENTHESIS  // )
#define JP_LBRACE       RIGHT_BRACE       // {
#define JP_RBRACE       PIPE              // }
#define JP_KANA         LANGUAGE_1        // かな
#define JP_EISU         LANGUAGE_2        // 英数
#define JP_HANZEN       GRAVE             // 半角/全角

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt { tapping-term-ms = <150>; };

/ {
    combos {
        compatible = "zmk,combos";

        shift_wquote {
            bindings = <&kp JP_DQUOTE>;
            key-positions = <24 30>;
        };

        caps_lock {
            bindings = <&kp CAPSLOCK>;
            key-positions = <24 12>;
        };

        muhenkan {
            bindings = <&kp INT_MUHENKAN>;
            key-positions = <42 30>;
        };

        underscore {
            bindings = <&kp JP_UNDERSCORE>;
            key-positions = <24 22>;
        };

        equal {
            bindings = <&kp JP_EQUAL>;
            key-positions = <24 23>;
        };

        hatena {
            bindings = <&kp QUESTION>;
            key-positions = <24 35>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            bindings = <
&mt ESCAPE JP_HANZEN  &kp Q         &kp W         &kp E               &kp R        &kp T  &kp Y            &kp U             &kp I  &kp O      &kp P         &kp BACKSPACE
&mt LCTRL TAB         &kp A         &kp S         &kp D               &kp F        &kp G  &kp H            &kp J             &kp K  &kp L      &lt 5 MINUS   &kp ENTER
&kp LEFT_SHIFT        &kp Z         &kp X         &kp C               &kp V        &kp B  &kp JP_QUOTE     &kp N             &kp M  &kp COMMA  &kp DOT       &kp SLASH
                      &kp LEFT_WIN  &kp LEFT_ALT  &lt 2 INT_MUHENKAN  &lt 3 SPACE  &mo 6  &lt 4 BACKSPACE  &lt 7 INT_HENKAN                    &kp JP_COLON
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans       &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &lt 5 MINUS  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans       &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans                        &trans
            >;
        };

        FUNCTION {
            bindings = <
&trans  &kp EXCLAMATION  &kp JP_AT  &kp HASH  &kp DOLLAR  &kp PERCENT  &kp JP_CARET  &kp JP_AMPERSAND  &kp JP_ASTERISK  &kp JP_LPAREN  &kp JP_RPAREN      &trans
&trans  &kp F1           &kp F2     &kp F3    &kp F4      &kp F5       &trans        &trans            &trans           &trans         &kp JP_UNDERSCORE  &kp LS(ENTER)
&trans  &kp F6           &kp F7     &kp F8    &kp F9      &kp F10      &trans        &trans            &trans           &trans         &trans             &trans
        &kp F11          &kp F12    &trans    &trans      &trans       &trans        &trans                                            &trans
            >;
        };

        NUM {
            bindings = <
&trans  &kp N1        &kp N2     &kp N3           &kp N4     &kp N5        &trans  &trans       &trans        &trans           &trans        &trans
&trans  &kp NUMBER_6  &kp N7     &kp N8           &kp N9     &kp N0        &trans  &kp KP_PLUS  &kp KP_MINUS  &kp KP_ASTERISK  &kp KP_SLASH  &trans
&trans  &kp JP_PLUS   &kp MINUS  &kp JP_ASTERISK  &kp SLASH  &kp JP_EQUAL  &trans  &trans       &trans        &trans           &trans        &trans
        &trans        &trans     &trans           &trans     &trans        &trans  &trans                                      &trans
            >;
        };

        ARROW {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &kp HOME     &kp UP         &kp END    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp LEFT     &kp DOWN       &kp RIGHT  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp PAGE_UP  &kp PAGE_DOWN  &trans     &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans       &trans                            &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans              &trans               &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LA(LEFT_ARROW)  &kp LA(RIGHT_ARROW)  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans              &trans               &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans                                           &trans
            >;
        };

        Bluetooth {
            bindings = <
&trans  &trans        &trans        &trans        &trans  &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans
&trans  &trans        &trans        &trans        &trans  &trans  &trans        &trans        &trans        &trans        &trans          &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans  &bootloader   &trans        &trans        &trans        &trans          &bt BT_CLR
        &trans        &trans        &trans        &trans  &trans  &trans        &trans                                    &bt BT_CLR_ALL
            >;
        };

        symbol {
            bindings = <
&trans  &trans            &trans         &kp JP_PIPE    &kp JP_TILDE  &kp JP_CARET      &kp EXCLAMATION  &kp HASH         &kp DOLLAR     &kp PERCENT       &kp JP_AMPERSAND   &kp JP_AT
&trans  &kp SINGLE_QUOTE  &kp JP_DQUOTE  &kp SEMICOLON  &kp JP_COLON  &kp JP_BACKQUOTE  &kp JP_LPAREN    &kp JP_RPAREN    &kp JP_LBRACE  &kp JP_RBRACE     &kp JP_UNDERSCORE  &kp JP_EQUAL
&trans  &trans            &trans         &trans         &kp JP_YEN    &trans            &kp JP_LBRACKET  &kp JP_RBRACKET  &kp LESS_THAN  &kp GREATER_THAN  &trans             &kp QUESTION
        &trans            &trans         &trans         &trans        &trans            &trans           &trans                                            &trans
            >;
        };
    };
};
